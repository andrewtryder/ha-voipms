{
  "domain": "voipms",
  "services": {
    "send_sms": {
      "fields": {
        "to": {
          "name": "To",
          "description": "Destination phone number.",
          "required": true,
          "example": "5559876543",
          "selector": {
            "text": {
              "multiline": false,
              "multiple": false
            }
          }
        },
        "message": {
          "name": "Message",
          "description": "Text message to send.",
          "required": true,
          "example": "Hello from Home Assistant",
          "selector": {
            "text": {
              "multiline": true,
              "multiple": false
            }
          }
        },
        "did": {
          "name": "From DID",
          "description": "Sender DID. Defaults to the configured Default DID.",
          "required": false,
          "example": "5551234567",
          "selector": {
            "text": {
              "multiline": false,
              "multiple": false
            }
          }
        }
      },
      "description": "Send an SMS message through VoIP.MS.",
      "name": "Send SMS"
    }
  }
}
