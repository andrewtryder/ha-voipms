# VoIP.ms API credentials for E2E tests
# Do not commit real values to this file. Use it as a template for .env
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
VOIPMS_DEFAULT_DID=

# GitHub token for HACS installation (needs public repo read access)
HACS_GITHUB_TOKEN=

